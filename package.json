{
  "name": "@tapline/client",
  "version": "0.2.1",
  "description": "Typed TypeScript SDK for Tapline's web scraping APIs for YouTube, Airbnb, GMGN and GeckoTerminal.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaplineData/tapline-typescript.git"
  },
  "homepage": "https://tapline.sh/sign-up?utm_source=typescript_client&utm_medium=referral&utm_campaign=developer_acquisition&utm_content=package_metadata",
  "keywords": [
    "tapline",
    "typescript",
    "youtube",
    "airbnb",
    "gmgn",
    "geckoterminal",
    "api",
    "client",
    "sdk",
    "scraping",
    "web-scraping",
    "scraping-api",
    "api-client",
    "youtube-scraper",
    "youtube-transcript",
    "airbnb-scraper",
    "gmgn-api",
    "geckoterminal-api",
    "crypto-data",
    "dex-data"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "tsx scripts/test-retry.ts && tsx scripts/test-bigint.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "lossless-json": "^4.3.0"
  }
}
